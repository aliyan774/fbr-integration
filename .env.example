# Copy to .env and edit.
#
# One instance serves both PRAL environments, chosen by the URL:
#   POST /api/v1/dev/invoices  -> sandbox    (validateinvoicedata_sb / postinvoicedata_sb, scenarioId required)
#   POST /api/v1/prd/invoices  -> production (validateinvoicedata / postinvoicedata, scenarioId stripped)
# SAP sends the Bearer token issued for that environment (ZFBR_TOKEN keyed by ENV).

# --- PRAL gateway ---
FBR_BASE_URL=https://gw.fbr.gov.pk
# Optional per-environment overrides, e.g. point dev at the local mock while prd stays real:
#FBR_DEV_BASE_URL=http://127.0.0.1:9000
#FBR_PRD_BASE_URL=https://gw.fbr.gov.pk
# Environments this instance accepts (others answer 404). Use "dev" on a sandbox-only box.
FBR_ENABLED_ENVS=dev,prd
FBR_TIMEOUT_SECONDS=30
FBR_MAX_RETRIES_5XX=3

# --- Concurrency ---
MAX_INFLIGHT_PER_SELLER=1
MAX_INFLIGHT_TOTAL=20

# --- Middleware auth: comma-separated, one key per SAP system ---
MIDDLEWARE_API_KEYS=change-me-sap-dev

# --- Storage ---
# SQLite (default, Windows friendly).
# PostgreSQL: postgresql+asyncpg://user:pass@host/db   (pip install .[postgres])
DATABASE_URL=sqlite+aiosqlite:///./data/fbr_middleware.db

# --- Reference sync (TODO: not implemented yet) ---
REFERENCE_SYNC_CRON=0 2 * * *

# --- Logging and listener ---
LOG_DIR=./logs
LOG_LEVEL=INFO
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8000
# Optional TLS directly on uvicorn (leave empty behind IIS ARR)
#SSL_CERTFILE=C:\fbr-middleware\cert.pem
#SSL_KEYFILE=C:\fbr-middleware\key.pem
